# Conexão com o PostgreSQL (formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/reservas?schema=public"

# Segredo usado para assinar os tokens JWT (use um texto longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=3000

# Endereço(s) do frontend autorizados pelo CORS (separe vários por vírgula)
CORS_ORIGIN="http://localhost:5173"

# Usuário administrador criado pelo seed (npm run db:seed)
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@restaurante.com"
ADMIN_SENHA="defina-uma-senha"
